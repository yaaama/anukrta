MAKEFLAGS += --no-print-directory

DEBUG ?= 1
ASAN ?= 1
PROFILE ?= 0

-include config.mk

# ==========================================
#   Project Settings
# ==========================================
TARGET_NAME := anukrta
TEST_TARGET_NAME := test
SRC_DIR := src
OBJ_DIR := build/objs
BUILD_DIR := build
INCLUDE_DIR := src
VENDOR_DIR := lib
TEST_DIR := tests

# DEFAULT C FLAGS
CFLAGS := -std=c11
CFLAGS += -Wall -Wextra -Wstrict-prototypes \
-Wold-style-definition -Wshadow -Wvla \
-Wconversion -Wdouble-promotion \
-Wmissing-include-dirs \
-Wnested-externs -Wno-sign-conversion \
-Wredundant-decls
# Disable pedantic for now
# -Wjump-misses-init \
# -pedantic

ifeq (${DEBUG}, 1)
	CFLAGS += $(DEV_FLAGS)
else
	CFLAGS += $(RELEASE_FLAGS)
endif

ifeq (${PROFILE}, 1)
	CFLAGS += $(PROFILE_FLAGS)
endif

INCLUDES = $(addprefix -I,$(VENDOR_DIR) $(SRC_DIR))
CPPFLAGS = $(INCLUDES) -MMD -MP $(PREPROC_DEFS)

# ==========================================
#   FFmpeg Configuration
# ==========================================
# FFmpeg libraries to link against
FFMPEG_LIBS := -lavcodec -lavdevice -lavfilter -lavformat -lavutil -lswresample -lswscale

# Combine flags
LDFLAGS :=
LDLIBS := -lm -lpthread -lz $(FFMPEG_LIBS)

# ==========================================
#  Address Sanitiser
# ==========================================
ifeq (${ASAN}, 1)
# ASAN Flags
	ASAN_FLAGS := -fsanitize=undefined -fsanitize=address -fsanitize-address-use-after-scope
	CFLAGS += $(ASAN_FLAGS) -fsanitize-trap
	LDFLAGS += $(ASAN_FLAGS)

# ASAN logfile
	ASAN_LOG_FILE := etc/asan.log

# ASAN Options
	DEFAULT_ASAN_OPTIONS := detect_leaks=1:abort_on_error=1:halt_on_error=1:log_path=$(ASAN_LOG_FILE):strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1
# LSAN Options
	DEFAULT_LSAN_OPTIONS := log_threads=1
# UBSAN Options
	DEFAULT_UBSAN_OPTIONS := abort_on_error=1:halt_on_error=1:print_stacktrace=1
endif

# ==========================================
#   Programmatic File Discovery
# ==========================================
# Find all .c files in SRC_DIR
SOURCES := $(shell find $(SRC_DIR) -name '*.c')
SOURCES += $(wildcard $(VENDOR_DIR)/*.c)
TEST_SOURCES := $(shell find $(TEST_DIR) -name '*.c' 2>/dev/null)

# Create object file names (src/main.c -> obj/main.o)
OBJECTS := $(SOURCES:%.c=$(OBJ_DIR)/%.o)
TEST_OBJECTS := $(TEST_SOURCES:%.c=$(OBJ_DIR)/%.o)

# Helper to remove main.o from the library link for tests
MAIN_OBJ := $(OBJ_DIR)/$(SRC_DIR)/main.o
LIB_OBJECTS := $(filter-out $(MAIN_OBJ), $(OBJECTS))


# Dependency files (generated by compiler)
DEPS := $(OBJECTS:.o=.d) $(TEST_OBJECTS:.o=.d)

# FILES := $(shell find $(SRC_DIR) $(TEST_DIR) -name '*.c' -o -name '*.h' -o -name '*.inl' 2> /dev/null)
FILES := $(shell find $(SRC_DIR) $(TEST_DIR) -path $(VENDOR_DIR) -prune -o \( -name '*.[ch]' -o -name '*.inl' \) -print 2>/dev/null)
# ==========================================
#   Build Rules
# ==========================================

.PHONY: all run clean test
# ALL
all: $(BUILD_DIR)/$(TARGET_NAME) $(BUILD_DIR)/$(TEST_TARGET_NAME)

# Linking
$(BUILD_DIR)/$(TARGET_NAME): $(OBJECTS)
	@mkdir -p $(dir $@)
	@echo "Linking $(TARGET_NAME)..."
	$(Q)$(CC) $(LDFLAGS) $^ $(LDLIBS) -o $@

# Test Linking
# Links: (App Objects - Main) + (Test Objects) + Criterion
$(BUILD_DIR)/$(TEST_TARGET_NAME): $(LIB_OBJECTS) $(TEST_OBJECTS)
	@mkdir -p $(dir $@)
	@echo "Linking Tests $(TEST_TARGET_NAME)..."
	$(Q)$(CC) $(LDFLAGS) $^ $(LDLIBS) -lcriterion -o $@

# Compiling Source
$(OBJ_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "Compiling $<..."
	$(Q)$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

# 5. Clean
clean:
	@echo "Cleaning up..."
	@rm -rf $(OBJ_DIR) $(BUILD_DIR)
	@rm -f etc/asan.log.*



.PHONY: bear
bear:
	@mkdir -p $(BUILD_DIR)
	@echo "Generating compile_commands.json..."
	$(Q)bear -- $(MAKE) -B all

.PHONY: run
run: $(BUILD_DIR)/$(TARGET_NAME)
ifeq (${ASAN}, 1)
	@echo "Running $(TARGET_NAME) with Sanitizers..."
	@echo "ASAN Options: $(DEFAULT_ASAN_OPTIONS)"
	@echo "Logs will be written to: $(ASAN_LOG_FILE).<pid>"
	@echo "=================================================="
	@ASAN_OPTIONS="$(DEFAULT_ASAN_OPTIONS):$(ASAN_OPTIONS)" \
LSAN_OPTIONS="$(DEFAULT_LSAN_OPTIONS):$(LSAN_OPTIONS)" \
UBSAN_OPTIONS="$(DEFAULT_UBSAN_OPTIONS):$(UBSAN_OPTIONS)" \
./$(BUILD_DIR)/$(TARGET_NAME)
else
	@echo "Running..."
	@echo "=================================================="
	@./$(BUILD_DIR)/$(TARGET_NAME)
endif

.PHONY: test
test: $(BUILD_DIR)/$(TEST_TARGET_NAME)
	@echo "Running Tests..."
ifeq (${ASAN}, 1)
	@ASAN_OPTIONS="$(DEFAULT_ASAN_OPTIONS)" ./$(BUILD_DIR)/$(TEST_TARGET_NAME)
else
	@./$(BUILD_DIR)/$(TEST_TARGET_NAME)
endif

.PHONY: analyze
analyze: clean
	scan-build --use-cc=clang -o $(BUILD_DIR)/scan-reports $(MAKE)

.PHONY: check
check:
	@echo "Running cppcheck..."
	@cppcheck --enable=all --disable=style,unusedFunction --check-level=exhaustive --language=c --inconclusive --std=c11 \
	--suppress=missingIncludeSystem \
	--template='{file}:{line}:{column}: {severity}: {message} [{id}]' \
	-i $(VENDOR_DIR) $(SRC_DIR)

.PHONY: format
format:
	@echo "Running clang-format"
	@clang-format -n -i $(FILES)

.PHONY: lint
lint:
	@echo "Running clang-tidy"
	@clang-tidy $(FILES)

.PHONY: release
release: clean
	$(MAKE) DEBUG=0 ASAN=0 all

.PHONY: release-debug
release-debug: clean
	$(MAKE) PROFILE=1 ASAN=0 DEBUG=0 all

.PHONY: debug
debug: clean
	$(MAKE) DEBUG=1 ASAN=1 all

.PHONY: memcheck
memcheck: clean
	$(MAKE) DEBUG=1 ASAN=0 all
	valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes $(BUILD_DIR)/$(TARGET_NAME)

# Include Dependencies
-include $(DEPS)
