# ==========================================
#   Project Settings
# ==========================================
TARGET_NAME := anukrta
TEST_TARGET_NAME := test_suite
SRC_DIR := src
OBJ_DIR := build/objs
BUILD_DIR := build
INCLUDE_DIR :=
TEST_DIR := tests

# Compiler settings
CC := clang

ASAN := 1
DEBUG := 1

# FLAGS FOR DEVELOPMENT
DEV_FLAGS := -ggdb -O0 -g3 \
-fextend-variable-liveness \
-ftrapv \
-Wdouble-promotion \
-Wconversion \
-Wno-sign-conversion \
-fno-omit-frame-pointer \
-Wno-unused-parameter \
-Wno-unused-variable \
-Wno-unused-function \
-Wno-incompatible-pointer-types-discards-qualifiers

# FLAGS FOR RELEASE BUILD
RELEASE_FLAGS := -O2

# DEFAULT FLAGS
CFLAGS := -std=c11 \
-Wall -Wextra -Wstrict-prototypes \
-Wold-style-definition -Wshadow \
-Wvla -pedantic

ifeq (${DEBUG}, 1)
	CFLAGS += $(DEV_FLAGS)
else
	CFLAGS += $(RELEASE_FLAGS)
endif

INCLUDES = $(addprefix -I,$(SRC_DIR) $(INCLUDE_DIR))

CPPFLAGS = $(INCLUDES) -MMD -MP

# ==========================================
#   FFmpeg Configuration
# ==========================================
# FFmpeg libraries to link against
FFMPEG_LIBS := -lavformat \
-lavcodec \
-lavutil \
-lswscale \
-lswresample \
-lavfilter \
-lavdevice

# Combine flags
ALL_CFLAGS := $(CFLAGS) -I$(INCLUDE_DIR) $(FFMPEG_INC)
ALL_LDFLAGS :=
ALL_LDLIBS := -lm -lpthread -lz $(FFMPEG_LIBS)

# ==========================================
#  Address Sanitiser
# ==========================================
ifeq (${ASAN}, 1)
# ASAN Flags
ASAN_FLAGS := -fsanitize=undefined,address

ALL_CFLAGS += $(ASAN_FLAGS) -fsanitize-trap -fno-optimize-sibling-calls
# -fsanitize-address-use-after-return=always  -fsanitize-address-use-after-scope

ALL_LDFLAGS += $(ASAN_FLAGS)

# Name of ASAN logfile
ASAN_LOG_FILE := etc/asan.log

# Default options
DEFAULT_ASAN_OPTIONS := detect_leaks=1:abort_on_error=1:halt_on_error=1:log_path=$(ASAN_LOG_FILE):strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1
DEFAULT_UBSAN_OPTIONS := abort_on_error=1:halt_on_error=1:print_stacktrace=1
endif

# ==========================================
#   Programmatic File Discovery
# ==========================================
# Find all .c files in SRC_DIR
SOURCES := $(wildcard $(SRC_DIR)/*.c)
# Create object file names (e.g., src/main.c -> obj/main.o)
OBJECTS := $(SOURCES:$(SRC_DIR)/%.c=$(OBJ_DIR)/%.o)
MAIN_OBJ := $(OBJ_DIR)/main.o
TEST_SOURCES := $(wildcard $(TEST_DIR)/*.c)
TEST_OBJECTS := $(TEST_SOURCES:$(TEST_DIR)/%.c=$(OBJ_DIR)/tests/%.o)

LIB_OBJECTS := $(filter-out $(MAIN_OBJ), $(OBJECTS))

# Dependency files (generated by compiler)
DEPS := $(OBJECTS:.o=.d) $(TEST_OBJECTS:.o=.d)

FILES := $(shell find $(SRC_DIR) $(TEST_DIR) $(INCLUDE_DIR) -name '*.c' -o -name '*.h' -o -name '*.inl' 2> /dev/null)

# ==========================================
#   Build Rules
# ==========================================

.PHONY: all test run bear clean
# ALL
all: $(BUILD_DIR)/$(TARGET_NAME)

# 1. Linking
$(BUILD_DIR)/$(TARGET_NAME): $(OBJECTS) | $(BUILD_DIR)
	@echo "=================================================="
	@echo "Linking $(TARGET_NAME)..."
	$(CC) $(ALL_LDFLAGS) $^ $(ALL_LDLIBS) -o $@

# 2. Test Linking
# Links: (App Objects - Main) + (Test Objects) + Criterion
$(BUILD_DIR)/$(TEST_TARGET_NAME): $(LIB_OBJECTS) $(TEST_OBJECTS) | $(BUILD_DIR)
	@echo "Linking Tests $(TEST_TARGET_NAME)..."
	$(CC) $(ALL_LDFLAGS) $^ $(ALL_LDLIBS) -lcriterion -o $@

# 3. Compiling
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c | $(OBJ_DIR)
	@echo "Compiling $<..."
	$(CC) $(ALL_CFLAGS) -c $< -o $@

# 4. Compiling Test Source
# Note: We create the subdir 'build/objs/tests' on the fly
$(OBJ_DIR)/tests/%.o: $(TEST_DIR)/%.c
	@mkdir -p $(dir $@)
	@echo "Compiling Test $<..."
	$(CC) $(ALL_CFLAGS) -c $< -o $@

# 4. Directory Creation
$(BUILD_DIR) $(OBJ_DIR):
	@mkdir -p $@

# 6. Include Dependencies
-include $(DEPS)

# 5. Clean
clean:
	@echo "Cleaning up..."
	@rm -rf $(OBJ_DIR) $(BUILD_DIR)
	@rm -f etc/asan.log.*

.PHONY: compile_commands.json
compile_commands.json: $(BUILD_DIR)/compile_commands.json

$(BUILD_DIR)/compile_commands.json:
	@echo "Generating compile_commands.json..."
	bear -o $(BUILD_DIR)/compile_commands.json -- $(MAKE) -B

# Alias for convenience
bear: compile_commands.json

.PHONY: run
run: $(BUILD_DIR)/$(TARGET_NAME)
	@echo "=================================================="
	@echo "Running $(TARGET_NAME) with Sanitizers..."
ifeq (${ASAN}, 1)
	@echo "ASAN Options: $(DEFAULT_ASAN_OPTIONS)"
	@echo "Logs will be written to: $(ASAN_LOG_FILE).<pid>"
endif
	@echo "=================================================="
	@ASAN_OPTIONS="$(DEFAULT_ASAN_OPTIONS):$(ASAN_OPTIONS)" \
	 UBSAN_OPTIONS="$(DEFAULT_UBSAN_OPTIONS):$(UBSAN_OPTIONS)" \
	 ./$(BUILD_DIR)/$(TARGET_NAME)

test: $(BUILD_DIR)/$(TEST_TARGET_NAME)
	@echo "Running Tests..."
ifeq (${ASAN}, 1)
	@ASAN_OPTIONS="$(DEFAULT_ASAN_OPTIONS)" ./$(BUILD_DIR)/$(TEST_TARGET_NAME) --verbose
else
	@./$(BUILD_DIR)/$(TEST_TARGET_NAME) --verbose
endif

.PHONY: format
format: bear
	@echo "Running clang-format"
	@clang-format -n -i $(FILES)

.PHONY: lint
lint: bear
	@echo "Running clang-tidy"
	@clang-tidy -p $(BUILD_DIR) --warnings-as-errors='*' $(FILES)

.PHONY: printvars
printvars:
	@printf "\
	OS: \"$(OS)\"\n \
	EXEC: \"$(TARGET_NAME)\"\n \
	TEST_EXEC: \"$(TEST_TARGET_NAME)\"\n \
	SRC_DIR: \"$(SRC_DIR)\"\n \
	OBJ_DIR: \"$(OBJ_DIR)\"\n \
	BUILD_DIR: \"$(BUILD_DIR)\"\n \
	SOURCES: \"$(SOURCES)\"\n \
	TEST_DIR: \"$(TEST_DIR)\"\n \
	TEST_SOURCES: \"$(TEST_SOURCES)\"\n \
	INCLUDE_DIR: \"$(INCLUDE_DIR)\"\n \
	INCLUDES: \"$(INCLUDES)\"\n \
	TEST_INCLUDES: \"$(TEST_INCLUDES)\"\n \
	CXX: \"$(CXX)\"\n \
	CPPFLAGS: \"$(CPPFLAGS)\"\n \
	LDFLAGS: \"$(ALL_LDFLAGS)\"\n \
	TEST_LDFLAGS: \"$(TEST_LDFLAGS)\"\n \
	ALL_LDLIBS: \"$(ALL_LDLIBS)\"\n \
	ALL_CFLAGS: \"$(ALL_CFLAGS)\"\n \
	TEST_LDLIBS: \"$(TEST_LDLIBS)\"\n \
	DEV_FLAGS: \"$(DEV_FLAGS)\"\n \
	"
